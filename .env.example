# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit credentials.

# ── Legacy LEP production (Azure SQL) — SQL auth reader account ──────────────
LEP_PROD_SERVER=sql-lep-data-prod.database.windows.net
LEP_PROD_DB=sqldb-lep-data-prod
LEP_PROD_USER=
LEP_PROD_PASSWORD=

# ── LaunchPad 2.0 production (Lakebase Postgres) ─────────────────────────────
# These can live here OR in %USERPROFILE%\.launchpad\launchpad-prod.env
# (the repo-local .env is read first; the first value found wins).
LAUNCHPAD_PROD_DATABASE_HOST=
LAUNCHPAD_PROD_DATABASE_PORT=5432
LAUNCHPAD_PROD_DATABASE_NAME=databricks_postgres
LAUNCHPAD_PROD_DATABASE_USER=
LAUNCHPAD_PROD_DATABASE_SSLMODE=require

# Token minting (option 3 in launchpad_prod_db.py). The Databricks PAT is NOT
# the Postgres password — Lakebase needs a short-lived OAuth JWT (~1 h), which
# the connector mints via the Databricks CLI when these three are set:
LAUNCHPAD_PROD_DATABRICKS_HOST=
LAUNCHPAD_PROD_DATABRICKS_TOKEN=
LAUNCHPAD_PROD_LAKEBASE_ENDPOINT=projects/launchpad/branches/production/endpoints/primary
